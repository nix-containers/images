diff --git a/WORKSPACE b/WORKSPACE
index 60f2c766..b2b2aa82 100644
--- a/WORKSPACE
+++ b/WORKSPACE
@@ -35,6 +35,19 @@ ENVOY_REPO = "envoy"
 # persist the option in `user.bazelrc`.
 http_archive(
     name = "envoy",
+    # istio/proxy 1.31 carries no Envoy patches of its own (the 0001-0013
+    # security backports are in Envoy 1.39 upstream), so the patch list is
+    # reintroduced here solely for the AWS-LC FIPS_202205 compliance shim
+    # (0014), the context_impl.h include it needs on 1.39 (0015), and an
+    # openssl/sha.h include that the FIPS 3.1.0 headers can satisfy (0016), and
+    # the 1.39 CNSA policy enumerators, rejected at runtime by the shim (0017).
+    patch_args = ["-p1"],
+    patches = [
+        "@io_istio_proxy//bazel:0014-tls-emulate-FIPS_202205-compliance-policy-on-AWS-LC.patch",
+        "@io_istio_proxy//bazel:0015-tls-include-aws_lc_compat-in-context_impl.patch",
+        "@io_istio_proxy//bazel:0016-gcp_authn-use-openssl-sha.h-for-AWS-LC-FIPS-3.1.patch",
+        "@io_istio_proxy//bazel:0017-tls-declare-CNSA-compliance-policies-on-AWS-LC.patch",
+    ],
     sha256 = ENVOY_SHA256,
     strip_prefix = ENVOY_REPO + "-" + ENVOY_SHA,
     url = "https://github.com/" + ENVOY_ORG + "/" + ENVOY_REPO + "/archive/" + ENVOY_SHA + ".tar.gz",
@@ -54,6 +67,48 @@ load("@envoy//bazel:api_repositories.bzl", "envoy_api_dependencies")
 
 envoy_api_dependencies()
 
+# Pin @aws_lc to the CMVP-validated AWS-LC FIPS module instead of Envoy's
+# default AWS-LC mainline release. envoy_http_archive() skips any repository
+# already defined here, so Envoy's own aws_lc BUILD file and FIPS genrule
+# (bazel/external/aws_lc.BUILD, aws_lc.genrule_cmd: cmake -DFIPS=1, static
+# libcrypto.a) are reused unchanged.
+#
+# Module : AWS-LC 3 Cryptographic Module (static), version AWS-LC FIPS 3.1.0
+# Cert   : NIST CMVP #5314 (FIPS 140-3 L1)
+# Source : URL and SHA2-256 exactly as given in Security Policy section 11.1.
+# The archive is used unmodified (no patches), as the policy requires.
+#
+# Starlark rule loaded explicitly: istio/proxy 1.31 builds with Bazel 8, where
+# the native WORKSPACE repository rules are on their way out.
+load("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
+
+new_local_repository(
+    name = "aws_lc",
+    path = "/awslc-prebuilt",
+    build_file_content = """
+load("@rules_cc//cc:defs.bzl", "cc_library")
+licenses(["notice"])
+cc_library(
+    name = "crypto",
+    srcs = ["crypto/libcrypto.a"],
+    hdrs = glob(["include/openssl/*.h"]),
+    includes = ["include"],
+    linkstatic = True,
+    visibility = ["//visibility:public"],
+)
+cc_library(
+    name = "ssl",
+    srcs = ["ssl/libssl.a"],
+    hdrs = glob(["include/openssl/*.h"]),
+    includes = ["include"],
+    linkstatic = True,
+    visibility = ["//visibility:public"],
+    deps = [":crypto"],
+)
+""",
+)
+
+
 load("@envoy//bazel:repositories.bzl", "envoy_dependencies")
 
 envoy_dependencies()
diff --git a/bazel/0014-tls-emulate-FIPS_202205-compliance-policy-on-AWS-LC.patch b/bazel/0014-tls-emulate-FIPS_202205-compliance-policy-on-AWS-LC.patch
new file mode 100644
index 00000000..febcbe1d
--- /dev/null
+++ b/bazel/0014-tls-emulate-FIPS_202205-compliance-policy-on-AWS-LC.patch
@@ -0,0 +1,66 @@
+From: Lucas Pick <lpick@tiberius.com>
+Subject: [PATCH] tls: emulate FIPS_202205 compliance policy on AWS-LC
+
+---
+--- a/source/common/tls/aws_lc_compat.h
++++ b/source/common/tls/aws_lc_compat.h
+@@ -1,5 +1,6 @@
+ #pragma once
+
++#include <openssl/nid.h>
+ #include <openssl/ssl.h>
+
+ // Aws-lc can be utilized as an alternative to boringssl
+@@ -13,16 +14,46 @@
+ #ifdef OPENSSL_IS_AWSLC
+ #define sk_X509_NAME_find sk_X509_NAME_find_awslc
+
+-// AWS-LC does not support BoringSSL's compliance policy API.
+-// Define the enum and a stub that returns failure so call sites
+-// can handle it through normal error paths without #ifdef guards.
++// AWS-LC does not support BoringSSL's compliance policy API. Emulate
++// ssl_compliance_policy_fips_202205 with public AWS-LC APIs so that
++// TlsParameters.compliance_policies: [FIPS_202205] enforces the same
++// restrictions as on BoringSSL instead of failing context creation:
++//   * protocol: TLS 1.2 minimum (a higher configured minimum is kept)
++//   * TLS 1.2 ciphers: ECDHE-(ECDSA|RSA)-AES(128|256)-GCM only
++//   * TLS 1.3 ciphers: TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384 only
++//   * groups: P-256, P-384 (no X25519, no hybrid KEMs)
++//   * signature algorithms: RSA PKCS#1 / PSS with SHA-256/384/512 and
++//     ECDSA P-256/SHA-256, P-384/SHA-384 (no SHA-1, no Ed25519)
++// Not emulated: AWS-LC has no API to *require* the extended master secret
++// extension on TLS 1.2; it is negotiated whenever the peer offers it.
++// Envoy applies the compliance policy last, so these settings override any
++// earlier cipher/curve configuration, matching BoringSSL's behaviour.
+ enum ssl_compliance_policy_t {
+   ssl_compliance_policy_fips_202205 = 1,
+ };
+
+-inline int SSL_CTX_set_compliance_policy(SSL_CTX* /*ctx*/,
+-                                         enum ssl_compliance_policy_t /*policy*/) {
+-  return 0;
++inline int SSL_CTX_set_compliance_policy(SSL_CTX* ctx, enum ssl_compliance_policy_t policy) {
++  if (ctx == nullptr || policy != ssl_compliance_policy_fips_202205) {
++    return 0;
++  }
++  static const int kGroups[] = {NID_X9_62_prime256v1, NID_secp384r1};
++  static const uint16_t kSigAlgs[] = {
++      SSL_SIGN_RSA_PKCS1_SHA256,       SSL_SIGN_RSA_PKCS1_SHA384,
++      SSL_SIGN_RSA_PKCS1_SHA512,       SSL_SIGN_ECDSA_SECP256R1_SHA256,
++      SSL_SIGN_ECDSA_SECP384R1_SHA384, SSL_SIGN_RSA_PSS_RSAE_SHA256,
++      SSL_SIGN_RSA_PSS_RSAE_SHA384,    SSL_SIGN_RSA_PSS_RSAE_SHA512,
++  };
++  const uint16_t min_version = SSL_CTX_get_min_proto_version(ctx);
++  return (min_version >= TLS1_2_VERSION ||
++          SSL_CTX_set_min_proto_version(ctx, TLS1_2_VERSION)) &&
++         SSL_CTX_set_strict_cipher_list(ctx, "ECDHE-ECDSA-AES128-GCM-SHA256:"
++                                             "ECDHE-RSA-AES128-GCM-SHA256:"
++                                             "ECDHE-ECDSA-AES256-GCM-SHA384:"
++                                             "ECDHE-RSA-AES256-GCM-SHA384") &&
++         SSL_CTX_set_ciphersuites(ctx, "TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384") &&
++         SSL_CTX_set1_groups(ctx, kGroups, sizeof(kGroups) / sizeof(kGroups[0])) &&
++         SSL_CTX_set_signing_algorithm_prefs(ctx, kSigAlgs, sizeof(kSigAlgs) / sizeof(kSigAlgs[0])) &&
++         SSL_CTX_set_verify_algorithm_prefs(ctx, kSigAlgs, sizeof(kSigAlgs) / sizeof(kSigAlgs[0]));
+ }
+
+ // AWS-LC's X509_NAME_dup takes non-const X509_NAME*, unlike BoringSSL which accepts const.
diff --git a/bazel/0015-tls-include-aws_lc_compat-in-context_impl.patch b/bazel/0015-tls-include-aws_lc_compat-in-context_impl.patch
new file mode 100644
index 00000000..53b555f4
--- /dev/null
+++ b/bazel/0015-tls-include-aws_lc_compat-in-context_impl.patch
@@ -0,0 +1,21 @@
+From: Lucas Pick <lpick@tiberius.com>
+Subject: [PATCH] tls: include aws_lc_compat.h in context_impl.h
+
+Envoy 1.39 declares ContextImpl::setCompliancePolicy(enum
+ssl_compliance_policy_t) in context_impl.h. On AWS-LC that enum only exists
+in aws_lc_compat.h, which context_impl.h does not include, so any TU that
+includes context_impl.h before the compat header (for example
+default_tls_certificate_selector.cc) fails with "ISO C++ forbids forward
+references to 'enum' types". utility_lib, a dep of context_lib, exports the
+header.
+---
+--- a/source/common/tls/context_impl.h
++++ b/source/common/tls/context_impl.h
+@@ -19,6 +19,7 @@
+ 
+ #include "source/common/common/matchers.h"
+ #include "source/common/stats/symbol_table.h"
++#include "source/common/tls/aws_lc_compat.h"
+ #include "source/common/tls/cert_validator/cert_validator.h"
+ #include "source/common/tls/context_manager_impl.h"
+ #include "source/common/tls/stats.h"
diff --git a/bazel/0016-gcp_authn-use-openssl-sha.h-for-AWS-LC-FIPS-3.1.patch b/bazel/0016-gcp_authn-use-openssl-sha.h-for-AWS-LC-FIPS-3.1.patch
new file mode 100644
index 00000000..8458b4a1
--- /dev/null
+++ b/bazel/0016-gcp_authn-use-openssl-sha.h-for-AWS-LC-FIPS-3.1.patch
@@ -0,0 +1,18 @@
+From: Lucas Pick <lpick@tiberius.com>
+Subject: [PATCH] gcp_authn: include openssl/sha.h instead of openssl/sha2.h
+
+openssl/sha2.h is a recent BoringSSL/AWS-LC header. The CMVP #5314 AWS-LC
+FIPS 3.1.0 module ships only openssl/sha.h, which declares the SHA256() and
+SHA256_DIGEST_LENGTH this file uses (BoringSSL also still provides sha.h).
+---
+--- a/source/extensions/filters/http/gcp_authn/crypto_utils.cc
++++ b/source/extensions/filters/http/gcp_authn/crypto_utils.cc
+@@ -3,7 +3,7 @@
+ #include <openssl/bio.h>
+ #include <openssl/mem.h>
+ #include <openssl/pem.h>
+-#include <openssl/sha2.h>
++#include <openssl/sha.h>
+ #include <openssl/x509.h>
+ 
+ #include <memory>
diff --git a/bazel/0017-tls-declare-CNSA-compliance-policies-on-AWS-LC.patch b/bazel/0017-tls-declare-CNSA-compliance-policies-on-AWS-LC.patch
new file mode 100644
index 00000000..423104ce
--- /dev/null
+++ b/bazel/0017-tls-declare-CNSA-compliance-policies-on-AWS-LC.patch
@@ -0,0 +1,23 @@
+From: Lucas Pick <lpick@tiberius.com>
+Subject: [PATCH] tls: declare the CNSA compliance policies on AWS-LC
+
+Envoy 1.39 added TlsParameters CNSA2_202603/CNSA1_202603, mapped to
+ssl_compliance_policy_cnsa{2,1}_202603, which only BoringSSL defines, so
+context_impl.cc does not compile on AWS-LC. Declare the enumerators; the
+SSL_CTX_set_compliance_policy shim (0014) rejects anything but FIPS_202205,
+so a CNSA config fails cleanly instead of being silently ignored.
+Applies after 0014.
+---
+--- a/source/common/tls/aws_lc_compat.h
++++ b/source/common/tls/aws_lc_compat.h
+@@ -30,6 +30,10 @@
+ // earlier cipher/curve configuration, matching BoringSSL's behaviour.
+ enum ssl_compliance_policy_t {
+   ssl_compliance_policy_fips_202205 = 1,
++  // Declared only so Envoy 1.39's CNSA cases compile; the shim above
++  // rejects them (returns 0), so such a config fails context creation.
++  ssl_compliance_policy_cnsa2_202603 = 2,
++  ssl_compliance_policy_cnsa1_202603 = 3,
+ };
+ 
+ inline int SSL_CTX_set_compliance_policy(SSL_CTX* ctx, enum ssl_compliance_policy_t policy) {
