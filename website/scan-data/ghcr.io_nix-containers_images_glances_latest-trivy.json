              "V40Vector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N",
              "V3Score": 5.3,
              "V40Score": 6.9
            },
            "nvd": {
