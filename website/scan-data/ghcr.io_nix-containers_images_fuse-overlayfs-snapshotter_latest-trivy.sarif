                "cvssv40_vector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:H/VA:N/SC:H/SI:H/SA:N",
                "precision": "very-high",
                "security-severity": "8.0",
                "tags": [
