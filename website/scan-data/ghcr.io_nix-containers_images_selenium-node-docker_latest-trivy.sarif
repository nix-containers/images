            {
              "id": "CVE-2024-8184",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "org.eclipse.jetty:jetty-server: jetty: Jetty ThreadLimitHandler.getRemote() vulnerable to remote DoS attacks"
              },
              "fullDescription": {
                "text": "There exists a security vulnerability in Jetty's ThreadLimitHandler.getRemote() which can be exploited by unauthorized users to cause remote denial-of-service (DoS) attack.  By repeatedly sending crafted requests, attackers can trigger OutofMemory errors and exhaust the server's memory."
              },
              "defaultConfiguration": {
                "level": "warning"
