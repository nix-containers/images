            {
              "id": "CVE-2020-5529",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "htmlunit: malicious JavaScript code leads to arbitrary java code execution"
              },
              "fullDescription": {
                "text": "HtmlUnit prior to 2.37.0 contains code execution vulnerabilities. HtmlUnit initializes Rhino engine improperly, hence a malicious JavScript code can execute arbitrary Java code on the application. Moreover, when embedded in Android application, Android-specific initialization of Rhino engine is done in an improper way, hence a malicious JavaScript code can execute arbitrary Java code on the application."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2020-5529",
