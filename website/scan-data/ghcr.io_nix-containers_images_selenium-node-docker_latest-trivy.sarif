            {
              "id": "CVE-2023-3635",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "okio: GzipSource class improper exception handling"
              },
              "fullDescription": {
                "text": "GzipSource does not handle an exception that might be raised when parsing a malformed gzip buffer. This may lead to denial of service of the Okio client when handling a crafted GZIP archive, by using the GzipSource class.\n\n"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2023-3635",
              "help": {
