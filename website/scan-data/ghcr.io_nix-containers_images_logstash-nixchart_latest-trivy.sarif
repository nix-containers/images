            {
              "id": "CVE-2026-22860",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "rubygem-rack: Rack Directory Traversal via Rack:Directory"
              },
              "fullDescription": {
                "text": "Rack is a modular Ruby web server interface. Prior to versions 2.2.22, 3.1.20, and 3.2.5, `Rack::Directory`’s path check used a string prefix match on the expanded path. A request like `/../root_example/` can escape the configured root if the target path starts with the root string, allowing directory listing outside the intended root. Versions 2.2.22, 3.1.20, and 3.2.5 fix the issue."
              },
              "defaultConfiguration": {
                "level": "error"
