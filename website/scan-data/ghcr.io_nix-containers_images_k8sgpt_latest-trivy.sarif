              "id": "CVE-2026-35206",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "github.com/helm/helm: Helm: Files written to unexpected directory via specially crafted Chart"
              },
              "fullDescription": {
                "text": "Helm is a package manager for Charts for Kubernetes. In Helm versions \u003c=3.20.1 and \u003c=4.1.3, a specially crafted Chart will cause helm pull --untar  [chart URL | repo/chartname] to write the Chart's contents to the immediate output directory (as defaulted to the current working directory; or as given by the --destination and --untardir flags), rather than the expected output directory suffixed by the chart's name. This vulnerability is fixed in 3.20.2 and 4.1.4."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-35206",
              "help": {
