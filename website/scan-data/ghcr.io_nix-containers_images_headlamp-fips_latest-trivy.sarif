            {
              "id": "CVE-2026-44456",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "Hono: bodyLimit() can be bypassed for chunked / unknown-length requests"
              },
              "fullDescription": {
                "text": "Hono is a Web application framework that provides support for any JavaScript runtime. Prior to 4.12.16, bodyLimit() does not reliably enforce maxSize for requests without a usable Content-Length (e.g. Transfer-Encoding: chunked). Oversized requests can reach handlers and return 200 instead of 413. This vulnerability is fixed in 4.12.16."
              },
              "defaultConfiguration": {
                "level": "warning"
