            {
              "id": "CVE-2026-40542",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "httpclient: Apache HttpClient: Authentication bypass due to missing mutual authentication verification"
              },
              "fullDescription": {
                "text": "Missing critical step in authentication in Apache HttpClient 5.6 allows an attacker to cause the client to accept SCRAM-SHA-256 authentication without proper mutual authentication verification. Users are recommended to upgrade to version 5.6.1, which fixes this issue."
              },
