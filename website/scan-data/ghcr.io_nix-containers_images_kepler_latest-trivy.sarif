            {
              "id": "GHSA-q445-7m23-qrmw",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "openssl's `MemBio::get_buf` has undefined behavior with empty buffers"
              },
              "fullDescription": {
                "text": "Previously, `MemBio::get_buf` called `slice::from_raw_parts` with a null-pointer, which violates the functions invariants, leading to undefined behavior. In debug builds this would produce an assertion failure. This is now fixed.\n"
              },
              "defaultConfiguration": {
