              "id": "GHSA-xphf-cx8h-7q9g",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "`openssl` `X509StoreRef::objects` is unsound"
              },
              "fullDescription": {
                "text": "This function returned a reference into an OpenSSL datastructure, but there was no way to ensure OpenSSL would not mutate the datastructure behind one's back.\n\nUse of this function should be replaced with `X509StoreRef::all_certificates`.\n"
              },
              "defaultConfiguration": {
                "level": "warning"
