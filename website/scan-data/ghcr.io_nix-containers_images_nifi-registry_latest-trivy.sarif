              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "org.springframework/spring-webmvc: org.springframework/spring-webflux: Spring MVC and WebFlux: Stream corruption vulnerability when using Server-Sent Events"
