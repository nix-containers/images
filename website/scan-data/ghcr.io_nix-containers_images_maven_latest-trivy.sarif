                "markdown": "**Secret Maven settings.xml password**\n| Severity | Match |\n| --- | --- |\n|HIGH|      \u003cpassword\u003e*******\u003c/password\u003e|"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "8.0",
                "tags": [
                  "secret",
                  "security",
                  "HIGH"
                ]
              }
            }
          ],
          "version": "0.71.2"
        }
