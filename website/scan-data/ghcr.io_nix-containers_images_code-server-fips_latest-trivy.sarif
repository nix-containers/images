              "id": "GHSA-wx77-rp39-c6vg",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "Regular Expression Denial of Service in markdown"
              },
              "fullDescription": {
                "text": "All versions of `markdown` are vulnerable to Regular Expression Denial of Service (ReDoS). The `markdown.toHTML()` function has significantly degraded performance when parsing long strings containing underscores. This may lead to Denial of Service if the parser accepts user input.\n\n\n## Recommendation\n\nNo fix is currently available. Consider using an alternative package until a fix is made available."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://github.com/advisories/GHSA-wx77-rp39-c6vg",
