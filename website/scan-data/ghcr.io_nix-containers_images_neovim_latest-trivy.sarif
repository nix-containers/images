          ]
        },
        {
          "ruleId": "CVE-2026-44983",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Package: smallbitvec\nInstalled Version: 2.6.0\nVulnerability CVE-2026-44983\nSeverity: HIGH\nFixed Version: \nLink: [CVE-2026-44983](https://avd.aquasec.com/nvd/cve-2026-44983)"
          },
          "locations": [
