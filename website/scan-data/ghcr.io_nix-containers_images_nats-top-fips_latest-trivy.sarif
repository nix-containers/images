            {
              "id": "CVE-2026-33222",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "nats-server: NATS-Server: Unauthorized data modification via JetStream stream restore"
              },
              "fullDescription": {
                "text": "NATS-Server is a High-Performance server for NATS.io, a cloud and edge native messaging system. Prior to versions 2.11.15 and 2.12.6, users with JetStream admin API access to restore one stream could restore to other stream names, impacting data which should have been protected against them. Versions 2.11.15 and 2.12.6 contain a fix. As a workaround, if developers have configured users to have limited JetStream restore permissions, temporarily remove those permissions."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-33222",
