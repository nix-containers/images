            {
              "id": "CVE-2026-33218",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "nats-server: github.com/nats-io/nats-server: NATS-Server: Denial of Service via malformed message pre-authentication on leafnode port"
              },
              "fullDescription": {
                "text": "NATS-Server is a High-Performance server for NATS.io, a cloud and edge native messaging system. Prior to versions 2.11.15 and 2.12.6, a client which can connect to the leafnode port can crash the nats-server with a certain malformed message pre-authentication. Versions 2.11.15 and 2.12.6 contain a fix. As a workaround, disable leafnode support if not needed or restrict network connections to the leafnode port, if plausible without compromising the service offered."
              },
              "defaultConfiguration": {
                "level": "error"
              },
