            {
              "id": "CVE-2026-39826",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "html/template: golang: html/template: Cross-site scripting due to incorrect script tag escaping"
              },
              "fullDescription": {
                "text": "If a trusted template author were to write a \u003cscript\u003e tag containing an empty 'type' attribute or a 'type' attribute with an ASCII whitespace, the execution of the template would incorrectly escape any data passed into the \u003cscript\u003e block."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-39826",
